import 'package:flutter/material.dart';

void main() => runApp(const MyApp());

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Product Preview',
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Colors.indigo,
      ),
      home: const ProductPreviewScreen(),
    );
  }
}

class ProductPreviewScreen extends StatefulWidget {
  const ProductPreviewScreen({super.key});

  @override
  State<ProductPreviewScreen> createState() => _ProductPreviewScreenState();
}

class _ProductPreviewScreenState extends State<ProductPreviewScreen> {
  // ----- Demo data -----
  static const String _title = 'Apple iPhone 18 Pro Max';
  static const String _price = '\$1,299';
  static const String _storage = '256 GB';
  static const double _rating = 4.8;
  static const int _reviews = 2150;
  static const List<String> _categories = [
    'Smartphones',
    'Apple',
    '5G',
    'A20 Pro',
    '6.9" Super Retina XDR',
    '48MP Camera',
  ];
  static const String _description =
      'Apple\'s largest Pro iPhone with a 6.9-inch Super Retina XDR display '
      'and a smaller Dynamic Island, powered by the A20 Pro chip. Triple '
      '48MP rear cameras with variable aperture and an 18MP front camera. '
      'Available in black, silver, glacier and burgundy.';

  bool _bookmarked = false;

  // ----- Cover image: Stack with bookmark badge + discount badge -----
  Widget _buildCover() {
    return AspectRatio(
      aspectRatio: 4 / 3,
      child: ClipRRect(
        borderRadius: BorderRadius.circular(16),
        child: Stack(
          fit: StackFit.expand,
          children: [
            // Layer 1: drawn iPhone illustration (works in the browser too)
            const IphoneIllustration(),

            // Layer 2: bookmark badge (top-right)
            Positioned(
              top: 12,
              right: 12,
              child: Material(
                color: Colors.white,
                elevation: 3,
                shape: const CircleBorder(),
                child: InkWell(
                  customBorder: const CircleBorder(),
                  onTap: () => setState(() => _bookmarked = !_bookmarked),
                  child: Padding(
                    padding: const EdgeInsets.all(8),
                    child: Icon(
                      _bookmarked ? Icons.bookmark : Icons.bookmark_border,
                      color: _bookmarked ? Colors.indigo : Colors.black87,
                    ),
                  ),
                ),
              ),
            ),

            // Layer 3: discount badge (bottom-left)
            Positioned(
              left: 12,
              bottom: 12,
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                decoration: BoxDecoration(
                  color: Colors.indigo,
                  borderRadius: BorderRadius.circular(20),
                ),
                child: const Text(
                  'NEW',
                  style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  // ----- Star rating row -----
  Widget _buildRating() {
    return Row(
      children: [
        ...List.generate(5, (i) {
          IconData icon;
          if (_rating >= i + 1) {
            icon = Icons.star;
          } else if (_rating > i) {
            icon = Icons.star_half;
          } else {
            icon = Icons.star_border;
          }
          return Icon(icon, color: Colors.amber, size: 20);
        }),
        const SizedBox(width: 8),
        // Flexible prevents overflow on very narrow screens / big fonts
        Flexible(
          child: Text(
            '$_rating ($_reviews reviews)',
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: Theme.of(context).textTheme.bodyMedium,
          ),
        ),
      ],
    );
  }

  // ----- Category badge -----
  Widget _buildBadge(String label) {
    final scheme = Theme.of(context).colorScheme;
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      decoration: BoxDecoration(
        color: scheme.secondaryContainer,
        borderRadius: BorderRadius.circular(20),
      ),
      child: Text(
        label,
        style: TextStyle(
          color: scheme.onSecondaryContainer,
          fontSize: 12,
          fontWeight: FontWeight.w600,
        ),
      ),
    );
  }

  // ----- Title + price, rating, category badges, description -----
  Widget _buildDetails() {
    final textTheme = Theme.of(context).textTheme;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // Row: title (Expanded) + price column
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Expanded(
              child: Text(
                _title,
                maxLines: 3,
                overflow: TextOverflow.ellipsis,
                style: textTheme.titleLarge
                    ?.copyWith(fontWeight: FontWeight.bold),
              ),
            ),
            const SizedBox(width: 12),
            Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text(
                  _price,
                  style: textTheme.titleLarge?.copyWith(
                    fontWeight: FontWeight.bold,
                    color: Colors.indigo,
                  ),
                ),
                Text(
                  'from · $_storage',
                  style: textTheme.bodySmall?.copyWith(color: Colors.grey),
                ),
              ],
            ),
          ],
        ),
        const SizedBox(height: 8),

        _buildRating(),
        const SizedBox(height: 16),

        // Wrap: badges flow onto new lines instead of overflowing
        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: _categories.map(_buildBadge).toList(),
        ),
        const SizedBox(height: 20),

        Text('Description', style: textTheme.titleMedium),
        const SizedBox(height: 6),
        Text(_description, style: textTheme.bodyMedium),
      ],
    );
  }

  // ----- Sticky bottom action bar -----
  Widget _buildBottomBar() {
    return Container(
      decoration: BoxDecoration(
        color: Theme.of(context).colorScheme.surface,
        boxShadow: const [
          BoxShadow(color: Colors.black26, blurRadius: 8, offset: Offset(0, -2)),
        ],
      ),
      child: SafeArea(
        top: false,
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Center(
            heightFactor: 1,
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 1000),
              child: Row(
                children: [
                  // Expanded => button takes the entire available width
                  Expanded(
                    child: FilledButton.icon(
                      style: FilledButton.styleFrom(
                        minimumSize: const Size(0, 52),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(12),
                        ),
                      ),
                      onPressed: () {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('Added to cart')),
                        );
                      },
                      icon: const Icon(Icons.shopping_cart_outlined),
                      label: const Text('Add to Cart'),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Product Preview')),
      body: SafeArea(
        child: LayoutBuilder(
          builder: (context, constraints) {
            final bool isWide = constraints.maxWidth >= 720;

            return SingleChildScrollView(
              padding: const EdgeInsets.all(16),
              child: Center(
                child: ConstrainedBox(
                  constraints: const BoxConstraints(maxWidth: 1000),
                  child: isWide
                      // Large screens: image left, details right
                      ? Row(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Expanded(flex: 5, child: _buildCover()),
                            const SizedBox(width: 24),
                            Expanded(flex: 4, child: _buildDetails()),
                          ],
                        )
                      // Small screens: stacked vertically
                      : Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            _buildCover(),
                            const SizedBox(height: 16),
                            _buildDetails(),
                          ],
                        ),
                ),
              ),
            );
          },
        ),
      ),
      bottomNavigationBar: _buildBottomBar(),
    );
  }
}

/// A drawn iPhone Pro Max illustration (no network, no assets needed),
/// so it renders everywhere: phone, emulator and the browser.
///
/// [both] = true  -> back (burgundy) + front phone
/// [both] = false -> only the front phone (for small thumbnails)
class IphoneIllustration extends StatelessWidget {
  const IphoneIllustration({super.key, this.both = true});

  final bool both;

  @override
  Widget build(BuildContext context) {
    return ColoredBox(
      color: const Color(0xFFF2F2F7),
      child: FittedBox(
        fit: BoxFit.contain,
        child: SizedBox(
          width: both ? 400 : 220,
          height: 300,
          child: CustomPaint(painter: _IphonePainter(both: both)),
        ),
      ),
    );
  }
}

class _IphonePainter extends CustomPainter {
  const _IphonePainter({required this.both});

  final bool both;

  static const double _w = 119;
  static const double _h = 250;

  @override
  void paint(Canvas canvas, Size size) {
    if (both) {
      _drawBack(canvas, const Offset(90, 25));
      _drawFront(canvas, const Offset(190, 35));
    } else {
      _drawFront(canvas, const Offset(50.5, 25));
    }
  }

  Paint _stroke(double width, Color color) => Paint()
    ..style = PaintingStyle.stroke
    ..strokeWidth = width
    ..color = color;

  void _drawBack(Canvas canvas, Offset o) {
    final rect = Rect.fromLTWH(o.dx, o.dy, _w, _h);
    final body = RRect.fromRectAndRadius(rect, const Radius.circular(22));

    canvas.drawShadow(Path()..addRRect(body), Colors.black54, 8, false);
    canvas.drawRRect(
      body,
      Paint()
        ..shader = const LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [Color(0xFFA23A4E), Color(0xFF5A1624)],
        ).createShader(rect),
    );
    canvas.drawRRect(body, _stroke(2, const Color(0xFFD9A3AD)));

    // Camera plateau with three lenses and a flash
    final base = Offset(o.dx + 10, o.dy + 10);
    final plateau = RRect.fromRectAndRadius(
      Rect.fromLTWH(base.dx, base.dy, 58, 58),
      const Radius.circular(14),
    );
    canvas.drawRRect(plateau, Paint()..color = const Color(0x33FFFFFF));
    canvas.drawRRect(plateau, _stroke(1, const Color(0x55FFFFFF)));
    for (final p in const [Offset(17, 17), Offset(17, 41), Offset(41, 29)]) {
      _drawLens(canvas, base + p);
    }
    canvas.drawCircle(
      base + const Offset(43, 11),
      3,
      Paint()..color = const Color(0xFFFFF3C4),
    );

    // Simple circle in the middle of the back panel
    canvas.drawCircle(
      Offset(o.dx + _w / 2, o.dy + _h * 0.55),
      9,
      _stroke(2, const Color(0x33FFFFFF)),
    );
  }

  void _drawLens(Canvas canvas, Offset c) {
    canvas.drawCircle(c, 11, Paint()..color = const Color(0xFF2B2B2E));
    canvas.drawCircle(c, 11, _stroke(1.5, const Color(0xFF8E8E93)));
    canvas.drawCircle(c, 7, Paint()..color = const Color(0xFF0B0B0D));
    canvas.drawCircle(c, 3.5, Paint()..color = const Color(0xFF1E2A5A));
    canvas.drawCircle(
      c + const Offset(-1.5, -1.5),
      1,
      Paint()..color = Colors.white70,
    );
  }

  void _drawFront(Canvas canvas, Offset o) {
    const frame = Color(0xFFB0B0B5);
    final body = RRect.fromRectAndRadius(
      Rect.fromLTWH(o.dx, o.dy, _w, _h),
      const Radius.circular(24),
    );

    // Side buttons
    final buttonPaint = Paint()..color = frame;
    for (final r in [
      Rect.fromLTWH(o.dx + _w - 1, o.dy + 80, 3, 34), // power
      Rect.fromLTWH(o.dx - 2, o.dy + 60, 3, 16), // action
      Rect.fromLTWH(o.dx - 2, o.dy + 90, 3, 26), // volume up
      Rect.fromLTWH(o.dx - 2, o.dy + 122, 3, 26), // volume down
    ]) {
      canvas.drawRRect(
        RRect.fromRectAndRadius(r, const Radius.circular(1.5)),
        buttonPaint,
      );
    }

    canvas.drawShadow(Path()..addRRect(body), Colors.black54, 10, false);
    canvas.drawRRect(body, Paint()..color = const Color(0xFF1C1C1E));
    canvas.drawRRect(body, _stroke(2.5, frame));

    // Screen with wallpaper
    final screenRect = Rect.fromLTWH(o.dx + 5, o.dy + 5, _w - 10, _h - 10);
    canvas.drawRRect(
      RRect.fromRectAndRadius(screenRect, const Radius.circular(19)),
      Paint()
        ..shader = const LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [Color(0xFF283593), Color(0xFF7E57C2), Color(0xFFFF8A65)],
        ).createShader(screenRect),
    );

    // Dynamic Island
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromCenter(
          center: Offset(o.dx + _w / 2, o.dy + 19),
          width: 34,
          height: 10,
        ),
        const Radius.circular(5),
      ),
      Paint()..color = Colors.black,
    );

    // Clock
    final tp = TextPainter(
      text: const TextSpan(
        text: '9:41',
        style: TextStyle(
          color: Colors.white,
          fontSize: 30,
          fontWeight: FontWeight.bold,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();
    tp.paint(
      canvas,
      Offset(o.dx + _w / 2 - tp.width / 2, o.dy + 62 - tp.height / 2),
    );

    // App icons grid
    const colors = [
      Color(0xFF34C759),
      Color(0xFF0A84FF),
      Color(0xFFFF9F0A),
      Color(0xFFFF453A),
      Color(0xFFBF5AF2),
      Color(0xFF64D2FF),
      Color(0xFFFFD60A),
      Color(0xFF30D158),
    ];
    const icon = 20.0;
    const gap = 7.0;
    final startX = o.dx + (_w - (4 * icon + 3 * gap)) / 2;
    final startY = o.dy + _h - 96;
    for (var i = 0; i < colors.length; i++) {
      final col = i % 4;
      final row = i ~/ 4;
      canvas.drawRRect(
        RRect.fromRectAndRadius(
          Rect.fromLTWH(
            startX + col * (icon + gap),
            startY + row * (icon + gap),
            icon,
            icon,
          ),
          const Radius.circular(6),
        ),
        Paint()..color = colors[i],
      );
    }

    // Home indicator
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromCenter(
          center: Offset(o.dx + _w / 2, o.dy + _h - 12),
          width: 38,
          height: 4,
        ),
        const Radius.circular(2),
      ),
      Paint()..color = Colors.white70,
    );
  }

  @override
  bool shouldRepaint(covariant _IphonePainter oldDelegate) =>
      oldDelegate.both != both;
}
